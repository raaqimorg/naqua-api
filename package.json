{
  "name": "naqua-api",
  "version": "1.0.0",
  "private": true,
  "description": "A product of Naqua (نقوة): a public API for Saudi (Tadawul) stock purification rates and calculations.",
  "license": "MIT",
  "homepage": "https://github.com/raaqimorg/naqua-api#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raaqimorg/naqua-api.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "dev": "node --watch src/server.ts",
    "start": "node src/server.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc",
    "lint": "eslint .",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "data:format": "node scripts/format-dataset.ts"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0",
    "effect": "4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
